rules_version = '2';

// Original PDFs are private: the server streams them (and the watermarked
// download copy) through /api routes using the Firebase Admin SDK, which
// bypasses these rules. Deny all direct client access.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
