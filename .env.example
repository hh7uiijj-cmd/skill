# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าให้ครบ

# --- Firebase Admin SDK (Firestore + Storage) ---
# สร้างจาก Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# วางค่า private_key ทั้งหมดในบรรทัดเดียว โดยแทนขึ้นบรรทัดใหม่ด้วย \n
FIREBASE_PRIVATE_KEY=
# ชื่อ Storage bucket เช่น your-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# --- ระบบแอดมิน ---
# รหัสลับที่แอดมินใช้เข้าสู่ระบบเพื่อเพิ่ม/แก้ไข/ลบผลงาน (ตั้งเองให้คาดเดายาก)
ADMIN_ACCESS_CODE=
# ค่าลับสุ่มสำหรับเซ็นชื่อ session cookie (สุ่มด้วย: openssl rand -base64 32)
SESSION_SECRET=

# --- ทั่วไป ---
# ชื่อเว็บไซต์ที่จะแสดงบน header และในลายน้ำ
SITE_NAME=คลังงานวิจัย
