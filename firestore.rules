rules_version = '2';

// ทุกข้อมูลอยู่ใต้ users/{uid}/... เท่านั้น -> การกรองด้วย user_id ถูกบังคับโดย path
// และตรวจซ้ำด้วย request.auth.uid == uid ในทุก match block (ป้องกันข้อมูลรั่วข้ามผู้ใช้)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isPositiveInt(v) {
      return v is int && v > 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.email is string
        && request.resource.data.baseCurrency is string
        && request.resource.data.timezone is string;
      allow update: if isOwner(uid);
      allow delete: if false;

      match /accounts/{accountId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['cash', 'bank', 'credit_card', 'e_wallet']
          && request.resource.data.initialBalanceCents is int
          && request.resource.data.currentBalanceCents is int
          && request.resource.data.archived == false;
        // currentBalanceCents ถูกอัปเดตแบบอะตอมมิกคู่กับ transaction เท่านั้น (ฝั่ง client ทำผ่าน runTransaction)
        allow update: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.currentBalanceCents is int;
        allow delete: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['income', 'expense'];
        allow update: if isOwner(uid) && request.resource.data.userId == uid;
        allow delete: if isOwner(uid);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && isPositiveInt(request.resource.data.amountCents)
          && request.resource.data.date is timestamp
          && request.resource.data.accountId is string
          && (
            (request.resource.data.type == 'transfer'
              && request.resource.data.toAccountId is string
              && request.resource.data.toAccountId != request.resource.data.accountId)
            || (request.resource.data.type != 'transfer'
              && request.resource.data.categoryId is string)
          );

        allow update: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && isPositiveInt(request.resource.data.amountCents)
          && request.resource.data.date is timestamp;

        // ห้ามลบจริง ใช้ soft delete (ตั้งค่า deletedAt ผ่าน update) เพื่อให้กู้คืนและเก็บประวัติได้
        allow delete: if false;
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && isPositiveInt(request.resource.data.amountCents)
          && request.resource.data.period == 'monthly'
          && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$');
        allow update: if isOwner(uid)
          && request.resource.data.userId == uid
          && isPositiveInt(request.resource.data.amountCents);
        allow delete: if isOwner(uid);
      }

      match /debts/{debtId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && isPositiveInt(request.resource.data.amountCents)
          && request.resource.data.dueDate is timestamp
          && request.resource.data.categoryId is string
          && request.resource.data.accountId is string
          && request.resource.data.status == 'pending'
          && request.resource.data.paidTransactionId == null;
        allow update: if isOwner(uid)
          && request.resource.data.userId == uid
          && isPositiveInt(request.resource.data.amountCents)
          && request.resource.data.status in ['pending', 'paid'];
        // ลบได้จริง (ไม่ใช่ประวัติการเงิน แค่รายการเช็คลิสต์ - ตัวรายจ่ายจริงยังอยู่ใน transactions เสมอ)
        allow delete: if isOwner(uid);
      }
    }
  }
}
