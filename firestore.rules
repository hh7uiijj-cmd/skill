rules_version = '2';

// All application access goes through the Next.js server using the Firebase
// Admin SDK, which bypasses these rules entirely. This deny-all is defense
// in depth in case a client ever tries to talk to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
